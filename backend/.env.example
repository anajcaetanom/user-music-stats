# Você mesmo define. Os valores usuais são development, production ou test. Em desenvolvimento use development.
# Em plataformas de deploy (Render, Railway, Heroku) normalmente você configura como production.
NODE_ENV=

# Local: redis://localhost:6379
# Docker: redis://redis:6379 (o nome é o do serviço no docker-compose)
# Hospedado (Upstash, Redis Cloud, Railway, Render): o painel do serviço mostra a connection string, algo como redis://default:senha@host:porta
REDIS_URL=

# Vem do Last.fm. Acesse https://www.last.fm/api/account/
LASTFM_API_KEY=
# É fixa
LASTFM_BASE_URL=https://ws.audioscrobbler.com/2.0/

# Vêm do painel do provedor OAuth do Spotify
# https://developer.spotify.com/dashboard
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=

# É a URL do seu frontend
FRONTEND_URI=

# Você gera. É uma string aleatória e longa usada para assinar os cookies de sessão.
SESSION_SECRET=